<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dacs4.filesync.controller.FilesController" spacing="16" styleClass="page">
    <Label text="Tìm tệp theo tên hoặc loại. Chọn một dòng để tải xuống hoặc đồng bộ." styleClass="muted-text"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="search" accessibleText="Tìm tên hoặc loại tệp" promptText="Tìm tên hoặc loại tệp…" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="status" accessibleText="Lọc theo trạng thái đồng bộ" prefWidth="174"/>
        <Button fx:id="clearFilters" text="Xóa bộ lọc" onAction="#clearFilters"/>
        <Button text="Tải lên" onAction="#upload"/>
    </HBox>
    <TableView fx:id="files" VBox.vgrow="ALWAYS" minHeight="140"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="count" styleClass="muted-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="download" text="Tải xuống" onAction="#download"/>
        <Button fx:id="sync" text="Đồng bộ" onAction="#sync" styleClass="primary"/>
    </HBox>
</VBox>
