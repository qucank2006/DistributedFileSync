<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dacs4.filesync.controller.FilesController" spacing="16" styleClass="page">
    <Label text="Tệp trên máy chủ" styleClass="section-title"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="search" accessibleText="Tìm theo tên tệp" promptText="Tìm theo tên tệp…" HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearFilters" text="Xóa tìm kiếm" onAction="#clearFilters"/>
        <Button fx:id="refresh" text="Làm mới" onAction="#refresh"/>
        <Button fx:id="upload" text="Tải lên" onAction="#upload" styleClass="primary"/>
    </HBox>
    <TableView fx:id="files" VBox.vgrow="ALWAYS" minHeight="140"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="count" styleClass="muted-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancel" text="Hủy truyền tệp" onAction="#cancel"/>
        <Button fx:id="download" text="Tải xuống" onAction="#download" styleClass="primary"/>
    </HBox>
    <VBox spacing="6">
        <ProgressBar fx:id="transferProgress" maxWidth="Infinity" visible="false" managed="false"
                     accessibleText="Tiến độ thao tác tệp"/>
        <Label fx:id="transferStatus" wrapText="true" styleClass="muted-text"/>
    </VBox>
</VBox>
