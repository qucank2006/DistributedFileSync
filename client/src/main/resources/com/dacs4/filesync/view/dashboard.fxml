<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dacs4.filesync.controller.DashboardController" spacing="16" styleClass="page">
    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0" minWidth="0" spacing="8" styleClass="card">
            <Label text="Kết nối máy chủ" styleClass="muted-text" wrapText="true"/>
            <Label fx:id="serverStatus" styleClass="badge,muted" wrapText="true"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0" minWidth="0" spacing="8" styleClass="card">
            <Label text="Tệp trên máy chủ" styleClass="muted-text" wrapText="true"/>
            <Label fx:id="fileCount" styleClass="metric-value"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0" minWidth="0" spacing="8" styleClass="card">
            <Label text="Lịch sử phiên bản" styleClass="muted-text" wrapText="true"/>
            <Label fx:id="historyStatus" styleClass="badge,muted" wrapText="true"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0" minWidth="0" spacing="8" styleClass="card">
            <Label text="Xung đột cần xem" styleClass="muted-text" wrapText="true"/>
            <Label fx:id="conflictCount" styleClass="metric-value"/>
        </VBox>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card">
        <Label text="Lần kết nối gần nhất" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lastConnected" text="Chưa có kết nối" styleClass="badge,muted"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Hoạt động kết nối" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="openConflicts" text="Xem xung đột"/>
    </HBox>
    <TableView fx:id="activities" VBox.vgrow="ALWAYS" minHeight="140"/>
</VBox>
