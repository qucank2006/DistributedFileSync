<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dacs4.filesync.controller.HistoryController" spacing="16" styleClass="page">
    <Label fx:id="historyStatus" wrapText="true" styleClass="muted-text"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <fx:define><ComboBox fx:id="file" promptText="Chọn tệp" prefWidth="285" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/></fx:define>
        <Label text="Tệp" labelFor="$file"/>
        <fx:reference source="file"/>
        <Button fx:id="historyRefresh" text="Làm mới" onAction="#refresh"/>
    </HBox>
    <TableView fx:id="versions" VBox.vgrow="ALWAYS" minHeight="140"/>
    <VBox spacing="8">
        <HBox fx:id="versionActions" spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="selectedDetails" text="Chọn một phiên bản để xem chi tiết."
                   minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="restore" text="Khôi phục…" disable="true" onAction="#restore" styleClass="action-width,primary"/>
        </HBox>
        <HBox fx:id="selectedPathRow" spacing="8" alignment="CENTER_LEFT">
            <fx:define><TextField fx:id="selectedPath" editable="false" minWidth="0" styleClass="readout" HBox.hgrow="ALWAYS"/></fx:define>
            <Label text="Đường dẫn" labelFor="$selectedPath"/>
            <fx:reference source="selectedPath"/>
        </HBox>
        <HBox fx:id="checksumRow" spacing="8" alignment="CENTER_LEFT">
            <fx:define><TextField fx:id="checksum" editable="false" minWidth="0" styleClass="readout" HBox.hgrow="ALWAYS"/></fx:define>
            <Label text="SHA-256" labelFor="$checksum"/>
            <fx:reference source="checksum"/>
            <Button fx:id="copyChecksum" text="Sao chép" accessibleText="Sao chép mã SHA-256" onAction="#copyChecksum"/>
            <Label fx:id="copyStatus" styleClass="muted-text"/>
        </HBox>
    </VBox>
    <Label fx:id="restoreStatus" wrapText="true" styleClass="muted-text" visible="false" managed="false"/>
</VBox>
